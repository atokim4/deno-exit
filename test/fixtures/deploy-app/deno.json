{
  // Sample app for the deno-exit tests (made-up data)
  "tasks": {
    "dev": "deno run -A --watch main.ts",
    "start": "deno run --allow-net --allow-env --allow-read --unstable-kv main.ts",
    "test": "deno test -A",
    "check": "deno check main.ts",
    "fmt": "deno fmt"
  },
  "imports": {
    "hono": "jsr:@hono/hono@^4.6.0",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/path": "jsr:@std/path@^1.0.0",
    "zod": "npm:zod@^3.23.8",
    "@/": "./src/"
  },
  "compilerOptions": {
    "jsx": "precompile",
    "jsxImportSource": "hono/jsx"
  },
  "fmt": { "lineWidth": 100 },
  "nodeModulesDir": "auto",
  "unstable": ["kv", "cron"]
}
